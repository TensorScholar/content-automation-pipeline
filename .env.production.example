# ============================================================================
# Content Automation Pipeline — PRODUCTION ENVIRONMENT TEMPLATE
# ============================================================================
# PURPOSE
#   Canonical, production-safe environment template. Placeholders only — no
#   live credentials. Copy to a production host as .env and fill values there.
#
#   cp .env.production.example .env
#
# NEVER copy a development .env (or the repository-local .env) to production.
# Development credentials are not valid production credentials and may already
# be exposed in local tooling, logs, or backups.
#
# CONFIGURATION MODEL (see docs/production-configuration.md)
#   [REQUIRED]      startup fails if absent or invalid (fail closed)
#   [OPTIONAL]      safe to leave empty; feature stays disabled
#   [EXTERNAL DB]   use to point at hosted/managed PostgreSQL and Redis
#   [COMPOSE ONLY]  consumed by the Docker Compose files, not the app itself
#
# ============================================================================

# ----------------------------------------------------------------------------
# [REQUIRED] Environment
# ----------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false

# ----------------------------------------------------------------------------
# [REQUIRED] PostgreSQL — application connection (asyncpg driver)
# ----------------------------------------------------------------------------
# Local Compose default (used when DATABASE_URL is empty):
#   postgresql+asyncpg://content_user:<POSTGRES_PASSWORD>@postgres:5432/content_automation
# External PostgreSQL example (managed provider):
#   postgresql+asyncpg://content_user:<PASSWORD>@db.example.com:5432/content_automation?ssl=require
#   (ssl=require for providers that mandate TLS; see docs/production-configuration.md)
DATABASE_URL=

# ----------------------------------------------------------------------------
# [COMPOSE ONLY] Local PostgreSQL (ignored when DATABASE_URL is set)
# ----------------------------------------------------------------------------
POSTGRES_PASSWORD=

# ----------------------------------------------------------------------------
# [REQUIRED] Redis — application cache (redis/rediss URL, optional password)
# ----------------------------------------------------------------------------
# Local Compose default (used when REDIS_URL is empty):
#   redis://:<REDIS_PASSWORD>@redis:6379/0
# External Redis example (managed provider, TLS):
#   rediss://:<PASSWORD>@redis.example.com:6379/0
REDIS_URL=

# [COMPOSE ONLY] Local Redis (ignored when REDIS_URL is set)
REDIS_PASSWORD=

# ----------------------------------------------------------------------------
# [REQUIRED] Celery — broker and results (Redis DBs 1 and 2 locally)
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ----------------------------------------------------------------------------
# [REQUIRED] Security
# ----------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Generate once, store in a secret manager, never rotate casually (re-encrypts
# stored WordPress credentials):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Comma-separated allowed Host headers. Production must include the public
# domain AND localhost,127.0.0.1 (container-internal healthchecks).
ALLOWED_HOSTS=
# Comma-separated CORS origins. Production must be explicit HTTPS origins —
# wildcards are rejected when ENVIRONMENT=production.
CORS_ORIGINS=

# ----------------------------------------------------------------------------
# [REQUIRED] TLS / reverse proxy (HTTPS overlay)
# ----------------------------------------------------------------------------
SERVER_NAME=

# ----------------------------------------------------------------------------
# [REQUIRED] LLM provider — the selected provider's key is required
# ----------------------------------------------------------------------------
# Select exactly one active provider. In production the selected provider must
# have a configured key/base URL at startup (fail closed).
LLM_PROVIDER=gemini

# Active provider: gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional provider: anthropic (leave empty if unused)
ANTHROPIC_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional provider: openai (leave empty if unused)
OPENAI_API_KEY=
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini

# Optional provider: openai_compatible (both required if selected)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_MODEL=compatible/google/gemini-2.5-flash-lite

# Optional provider: local (Ollama)
LOCAL_LLM_URL=

# [OPTIONAL] Explicit model roles. Leave empty to derive from LLM_PROVIDER.
LLM_PRIMARY_MODEL=
LLM_SECONDARY_MODEL=
LLM_FALLBACK_MODEL=
LLM_KEYWORD_MODEL=
LLM_PLANNING_MODEL=
LLM_WRITING_MODEL=
LLM_VERIFICATION_MODEL=

# [OPTIONAL] Cost controls (defaults: 60 rpm, 1M daily tokens, $10 daily /
# $100 monthly hard limits; 0 disables the project/user scopes)
LLM_DAILY_COST_LIMIT_USD=10
LLM_MONTHLY_COST_LIMIT_USD=100
LLM_PROJECT_DAILY_COST_LIMIT_USD=0
LLM_PROJECT_MONTHLY_COST_LIMIT_USD=0
LLM_USER_DAILY_COST_LIMIT_USD=0
LLM_USER_MONTHLY_COST_LIMIT_USD=0

# ----------------------------------------------------------------------------
# [OPTIONAL] Google Search Console (read-only OAuth)
#   All four must be set together or the integration stays disabled.
# ----------------------------------------------------------------------------
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REDIRECT_URI=https://<SERVER_NAME>/api/search-console/oauth/callback
GOOGLE_SEARCH_CONSOLE_FRONTEND_RETURN_URL=https://<SERVER_NAME>/?search_console=connected

# ----------------------------------------------------------------------------
# [OPTIONAL] Monitoring & error tracking
# ----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
MONITORING_LOG_LEVEL=INFO
LOG_LEVEL=INFO

# [COMPOSE ONLY] Celery process tuning
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=4

# [COMPOSE ONLY] Images and release
IMAGE_TAG=latest

# [COMPOSE ONLY] Flower (Celery UI). Required — no default credentials.
FLOWER_USER=
FLOWER_PASSWORD=

# [COMPOSE ONLY] Monitoring overlay (docker/docker-compose.monitoring.yml)
# Grafana. Required — no default password is accepted.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Public hostname used to build Grafana's root URL (defaults to SERVER_NAME).
GRAFANA_SERVER_NAME=
# Exporter endpoints (override only when PostgreSQL/Redis are external).
POSTGRES_EXPORTER_DSN=
REDIS_EXPORTER_ADDR=

# [OPTIONAL] Host-side PostgreSQL backups (backup_database.sh)
BACKUP_DIR=./backups
RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# [REQUIRED] Frontend public-variable boundary
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time.
# NEVER place secrets behind a NEXT_PUBLIC_ name. /api is relative and routed
# by the nginx reverse proxy.
NEXT_PUBLIC_API_URL=/api
# Optional Grafana dashboard link shown in the Monitoring panel. Plain HTTPS
# URL only — do not embed credentials, tokens, or internal addresses.
NEXT_PUBLIC_GRAFANA_URL=