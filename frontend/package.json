{
  "name": "cap-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "build:tauri": "TAURI_STATIC_EXPORT=1 next build",
    "start": "next start -p 3001",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "verify:ui": "node scripts/verify-ui-contract.mjs",
    "release:check": "npm run verify:static && npm run typecheck && npm run lint && npm run build:tauri",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:i18n": "node scripts/verify-i18n.mjs",
    "verify:syntax": "node scripts/verify-syntax.mjs",
    "verify:static": "npm run verify:syntax && npm run verify:ui && npm run verify:source && npm run verify:i18n && npm run verify:contrast",
    "verify:contrast": "node scripts/verify-contrast.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/cli": "^2.11.2",
    "clsx": "^2.1.1",
    "next": "15.5.23",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
