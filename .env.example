# ============================================================================
# Content Automation Pipeline - Environment Configuration
# ============================================================================
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Edit .env with your actual values
# 3. Initialize database:  poetry run python scripts/setup/setup_database.py
# 4. Start API:  poetry run uvicorn api.main:app --reload --port 8000
# 5. Start frontend:  cd frontend && npm run dev
#
# DO NOT commit .env file to version control!
# ============================================================================

# ----------------------------------------------------------------------------
# REQUIRED: Application Environment
# ----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
MONITORING_LOG_LEVEL=INFO
# Production must use:
# ENVIRONMENT=production
# DEBUG=false

# ----------------------------------------------------------------------------
# API & UI Ports (configure to avoid conflicts with other projects)
# Default: API=8000, UI=3001
# Custom: Change these if running multiple instances
# ----------------------------------------------------------------------------
API_PORT=8000
API_URL=http://127.0.0.1:8000
UI_PORT=3001
UI_URL=http://127.0.0.1:3001
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=/api
SERVER_NAME=localhost

# Browser access controls
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# ----------------------------------------------------------------------------
# REQUIRED: Database Configuration
# PostgreSQL 14+ required, 17+ recommended for full pgvector support
# Must have pgvector extension: CREATE EXTENSION vector;
#
# IMPORTANT: Use 'postgresql+asyncpg://' for Python app (async driver)
#            Use 'postgresql://' in docker-compose.yml (standard driver for healthchecks)
# ----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://content_user:secure_password_change_me@localhost:5432/content_automation
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO_SQL=false
DB_STATEMENT_TIMEOUT=30000

# ----------------------------------------------------------------------------
# REQUIRED: Redis Configuration
# Install: brew install redis && brew services start redis
# ----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=secure_redis_password_change_me
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_EMBEDDING_CACHE_TTL=2592000
REDIS_LLM_CACHE_TTL=2592000
REDIS_PATTERN_CACHE_TTL=604800

# ----------------------------------------------------------------------------
# REQUIRED: Security & Authentication
# SECRET_KEY MUST be at least 32 characters for production!
# CRITICAL: DO NOT use the default below! Generate a strong key with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# ----------------------------------------------------------------------------
SECRET_KEY=GENERATE_SECURE_KEY_DO_NOT_USE_THIS_DEFAULT_VALUE_IN_PRODUCTION
# JWT_SECRET_KEY is deprecated; SECRET_KEY is used for signing.

# Required in production for WordPress application-password encryption.
# Generate once and store it in the deployment secret manager. Rotating this
# key requires re-encrypting existing credentials.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ----------------------------------------------------------------------------
# REQUIRED: LLM API Keys (at least ONE required)
# Gemini is supported through Google AI Studio's simple API-key flow.
# The app exposes only providers with configured keys in the UI.
#
# Production rule:
# - LLM_PROVIDER selects the active provider.
# - The selected provider's key/base URL is required at startup.
# - Unselected provider keys are optional fallbacks and may be left empty.
# ----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GOOGLE_API_KEY=
LLM_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional Anthropic provider:
ANTHROPIC_API_KEY=
LLM_ANTHROPIC_API_KEY=
LLM_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional fallback providers (use standard env var names):
OPENAI_API_KEY=
LLM_OPENAI_API_KEY=
OPENAI_ORG_ID=
LLM_OPENAI_MODEL=gpt-4o-mini

# External OpenAI-compatible endpoint (for example a managed provider gateway).
# Use the compatible/ model prefix so the application does not label this route
# as a local model. Both values are required when LLM_PROVIDER=openai_compatible.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
LLM_OPENAI_COMPATIBLE_MODEL=compatible/google/gemini-2.5-flash-lite
LLM_OPENAI_COMPATIBLE_FALLBACK_MODEL=

# Optional local endpoint (for example Ollama). Direct local-model selection is
# independent from automatic fallback. Local fallback is fail-closed unless the
# operator explicitly enables it.
LOCAL_LLM_URL=
LOCAL_LLM_API_KEY=
LLM_LOCAL_FALLBACK_MODEL=
LLM_ENABLE_LOCAL_FALLBACK=false

# ----------------------------------------------------------------------------
# Content Generation Settings
# ----------------------------------------------------------------------------
LLM_PRIMARY_MODEL=gemini-2.5-flash-lite
LLM_SECONDARY_MODEL=gemini-2.5-flash-lite
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_REQUEST=4096
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_COST_ALERT_THRESHOLD=10.0
# Hard distributed cost limits. Global limits must be positive in production.
# A project/user value of 0 disables that optional scope.
LLM_DAILY_COST_LIMIT_USD=10
LLM_MONTHLY_COST_LIMIT_USD=100
LLM_PROJECT_DAILY_COST_LIMIT_USD=0
LLM_PROJECT_MONTHLY_COST_LIMIT_USD=0
LLM_USER_DAILY_COST_LIMIT_USD=0
LLM_USER_MONTHLY_COST_LIMIT_USD=0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0
LLM_DEFAULT_TEMPERATURE=0.7
LLM_CREATIVE_TEMPERATURE=0.9
LLM_DETERMINISTIC_TEMPERATURE=0.1

# ----------------------------------------------------------------------------
# NLP Settings
# ----------------------------------------------------------------------------
NLP_EMBEDDING_MODEL=all-MiniLM-L6-v2
NLP_EMBEDDING_DIMENSION=384
NLP_EMBEDDING_BATCH_SIZE=32
NLP_SPACY_MODEL=en_core_web_sm
NLP_HIGH_SIMILARITY_THRESHOLD=0.85
NLP_MEDIUM_SIMILARITY_THRESHOLD=0.70
NLP_LOW_SIMILARITY_THRESHOLD=0.50

# ----------------------------------------------------------------------------
# Scraping Settings
# ----------------------------------------------------------------------------
SCRAPING_USER_AGENT="ContentAutomationBot/1.0 (+http://example.com/bot)"
SCRAPING_REQUEST_TIMEOUT=30
SCRAPING_MAX_RETRIES=3
SCRAPING_HEADLESS=true
SCRAPING_BROWSER_TYPE=chromium
SCRAPING_MIN_DELAY_BETWEEN_REQUESTS=1.0
SCRAPING_MAX_CONCURRENT_REQUESTS=5
SCRAPING_MAX_ARTICLE_SAMPLE_SIZE=20
SCRAPING_MIN_ARTICLE_WORD_COUNT=300

# ----------------------------------------------------------------------------
# Celery Task Queue
# Production compose separates Redis DBs by role:
# - REDIS_URL uses DB 0 for app cache/rate-limit/blacklist.
# - CELERY_BROKER_URL uses DB 1 for queued work.
# - CELERY_RESULT_BACKEND uses DB 2 for task results.
# ----------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=4
CELERY_TASK_DEFAULT_QUEUE=content_generation
CELERY_TASK_DEFAULT_ROUTING_KEY=content.default
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ----------------------------------------------------------------------------
# Monitoring & Observability
# ----------------------------------------------------------------------------
MONITORING_ENABLE_PROMETHEUS=true
MONITORING_PROMETHEUS_PORT=9090
MONITORING_ENABLE_TRACING=false
MONITORING_TRACE_SAMPLE_RATE=0.1
MONITORING_ENABLE_STRICT_CSP=true
MONITORING_CSP_REPORT_ONLY=false

# Optional error tracking. Startup remains available when SENTRY_DSN is empty.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Host-side PostgreSQL backup configuration.
BACKUP_DIR=./backups
RETENTION_DAYS=7

# OpenTelemetry OTLP Export (for distributed tracing with Jaeger, Tempo, etc.)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=content-automation-api
OTEL_EXPORTER_OTLP_INSECURE=true

# ----------------------------------------------------------------------------
# Docker Compose Production Variables
# ----------------------------------------------------------------------------
POSTGRES_PASSWORD=secure_password_change_me
IMAGE_TAG=latest
FLOWER_USER=admin
FLOWER_PASSWORD=change_me_flower_password

# Production migrations are explicit to avoid concurrent Alembic upgrades from
# replicated API containers. Leave false for production API startup and run:
# docker compose -f docker-compose.prod.yml --profile migrate run --rm migrate
RUN_MIGRATIONS=false
